# --- environment ---
.venv/
__pycache__/
*.pyc
.DS_Store

# --- personal: your own FPL team id lives here, not in the repo ---
dashboard/fpl_config.json

# --- API response cache (regenerated on every run) ---
dashboard/.cache/
dashboard/.state/

# .state/ holds FITTED MODEL PARAMETERS (blend weights, the supremacy map, corners state),
# not cache - the build needs them, so they are tracked. Only the refit model cache is not.
.state/dc_prem.json
.state/odds_raw/

# --- build artifacts (regenerate with dashboard/refresh.sh) ---
dashboard/dashboard.json
dashboard/standalone.html
dashboard/floodlit_artifact.html
dashboard/refresh.log
dashboard/refresh.launchd.log
dashboard/.refresh.lock

# --- large regenerable analysis output ---
outputs/coldstart_sweep.csv
outputs/charts/
premier_league_history/player_gameweek.csv
dashboard/.Rhistory
